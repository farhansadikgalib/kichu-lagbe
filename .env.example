# Copy to .env.local and fill in real values (never commit .env.local).
# If the project is linked to Vercel, you can instead run:
#   npx vercel env pull .env.local

# PostgreSQL connection string (Aiven or any Postgres with SSL).
# TLS is on by default; append ?sslmode=disable for a local Postgres without it:
#   postgres://user@localhost:5432/kichulagbe?sslmode=disable
DATABASE_URL="postgres://user:password@host:port/dbname"

# Secret used to sign session JWTs (generate: openssl rand -hex 32)
SESSION_SECRET=""

# Firebase (Google sign-in) — Firebase console → project settings → your web app.
# NEXT_PUBLIC_* values ship to the browser by design.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server-side Firebase project id (usually same as NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=""

# Google OAuth (server-side sign-in flow) — optional; when unset the Google
# sign-in route reports itself as unconfigured and the rest of auth still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public site origin, used for metadata/canonical URLs. Falls back to the Vercel
# production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: POST every order event (order.created / order.updated) as JSON to
# this URL — a Slack/Telegram bridge, a receipt printer, another system. When
# ORDER_WEBHOOK_SECRET is set the body is signed: X-KichuLagbe-Signature: sha256=<hmac>.
ORDER_WEBHOOK_URL=""
ORDER_WEBHOOK_SECRET=""

# Web Push (VAPID). Generate a pair once and keep the private key secret:
#   node -e "console.log(require(\"web-push\").generateVAPIDKeys())"
# Without these, push subscriptions are refused and notifications stay in-app only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services (mailto: or https: URL).
VAPID_SUBJECT="mailto:you@example.com"

# Cloudflare Turnstile bot protection on login/register — optional; with these
# unset the widget never renders and the server skips verification.
# Create a widget (free): Cloudflare dashboard → Turnstile → Add site, with
# your hostnames (kichulagbe.vercel.app, localhost). Dev-only test keys that
# always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
